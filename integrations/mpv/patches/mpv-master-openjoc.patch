@@ -61,6 +61,11 @@ enum mp_speaker_id {
     MP_SPEAKER_ID_BFL,          // BOTTOM_FRONT_LEFT
     MP_SPEAKER_ID_BFR,          // BOTTOM_FRONT_RIGHT
 
+    // FFmpeg's explicit binaural transport identities. mpv maps these to
