+    MP_SPEAKER_ID_BIL = 61,     // BINAURAL_LEFT
+    MP_SPEAKER_ID_BIR,          // BINAURAL_RIGHT
+
     // Speaker IDs >= 64 are not representable in WAVEFORMATEXTENSIBLE or libav*.
 
     // "Silent" channels. These are sometimes used to insert padding for
diff --git a/audio/chmap_avchannel.c b/audio/chmap_avchannel.c
index ebf33bd233..00b54efd5c 100644
--- a/audio/chmap_avchannel.c
+++ b/audio/chmap_avchannel.c
@@ -33,8 +33,18 @@ bool mp_chmap_from_av_layout(struct mp_chmap *dst, const AVChannelLayout *src)
     case AV_CHANNEL_ORDER_NATIVE:
         mp_chmap_from_lavc(dst, src->u.mask);
         return dst->num == src->nb_channels;
+    case AV_CHANNEL_ORDER_CUSTOM:
+        if (src->nb_channels > MP_NUM_CHANNELS)
+            return false;
+        for (int n = 0; n < src->nb_channels; n++) {
+            enum AVChannel id = av_channel_layout_channel_from_index(src, n);
+            if (id == AV_CHAN_NONE || id >= MP_SPEAKER_ID_NA)
+                return false;
+            dst->speaker[n] = id;
+        }
+        dst->num = src->nb_channels;
+        return mp_chmap_is_valid(dst);
     default:
-        // TODO: handle custom layouts
         return false;
     }
 }
@@ -46,9 +56,13 @@ void mp_chmap_to_av_layout(AVChannelLayout *dst, const struct mp_chmap *src)
         .nb_channels = src->num,
     };
 
-    // TODO: handle custom layouts
     if (!mp_chmap_is_unknown(src)) {
-        av_channel_layout_from_mask(dst, mp_chmap_to_lavc(src));
+        if (mp_chmap_is_lavc(src)) {
+            av_channel_layout_from_mask(dst, mp_chmap_to_lavc(src));
+        } else if (av_channel_layout_custom_init(dst, src->num) >= 0) {
+            for (int n = 0; n < src->num; n++)
+                dst->u.map[n].id = src->speaker[n];
+        }
     }
 }
 
diff --git a/audio/decode/ad_lavc.c b/audio/decode/ad_lavc.c
index 9c83892afd..945e394322 100644
--- a/audio/decode/ad_lavc.c
+++ b/audio/decode/ad_lavc.c
