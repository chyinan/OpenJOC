+    // duplicate FFmpeg's internal strictness flag in --ad-lavc-o.
+    if (strcmp(decoder, "libopenjoc") == 0)
+        ctx->avctx->strict_std_compliance = FF_COMPLIANCE_EXPERIMENTAL;
+
     if (opts->downmix && mpopts->audio_output_channels.num_chmaps == 1) {
