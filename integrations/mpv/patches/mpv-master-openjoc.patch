     ctx->avctx->codec_id = lavc_codec->id;
     ctx->avctx->pkt_timebase = ctx->codec_timebase;
 
+    // OpenJOC is intentionally registered as an experimental, explicitly
+    // named decoder in FFmpeg. Selecting that name is already a positive
