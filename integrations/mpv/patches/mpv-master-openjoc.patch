+++ b/audio/aframe.c
@@ -131,6 +131,16 @@ struct mp_aframe *mp_aframe_from_avframe(struct AVFrame *av_frame)
         return NULL;
     }
 
+    // OpenJOC's binaural AVFrame is truthfully labelled BIL/BIR. mpv's
+    // transport model has no platform-independent ear endpoint, so expose
+    // those already-rendered streams as ordinary left/right AO channels. The
+    // AVFrame data and labels remain untouched; this is only a transport map,
+    // never a rematrix or crossfeed operation.
+    if (converted_map.num == 2 &&
+        converted_map.speaker[0] == MP_SPEAKER_ID_BIL &&
+        converted_map.speaker[1] == MP_SPEAKER_ID_BIR)
+        converted_map = (struct mp_chmap)MP_CHMAP_INIT_STEREO;
+
     int format = af_from_avformat(av_frame->format);
     if (!format && av_frame->format != AV_SAMPLE_FMT_NONE)
         return NULL;
