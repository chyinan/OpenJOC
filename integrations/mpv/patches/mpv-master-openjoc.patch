--- a/audio/chmap_avchannel.c
+++ b/audio/chmap_avchannel.c
@@ -33,8 +33,18 @@ bool mp_chmap_from_av_layout(struct mp_chmap *dst, const AVChannelLayout *src)
     case AV_CHANNEL_ORDER_NATIVE:
         mp_chmap_from_lavc(dst, src->u.mask);
         return dst->num == src->nb_channels;
+    case AV_CHANNEL_ORDER_CUSTOM:
+        if (src->nb_channels > MP_NUM_CHANNELS)
