     [MP_SPEAKER_ID_BFL]         = {"bfl",  "bottom front left"},
     [MP_SPEAKER_ID_BFR]         = {"bfr",  "bottom front right"},
+    [MP_SPEAKER_ID_BIL]         = {"bil",  "binaural left"},
