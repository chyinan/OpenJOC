From 0be7e69ecd3d6a03457a6d14562e7894fde42d5f Mon Sep 17 00:00:00 2001
From: chyinan <chyinan2015@gmail.com>
Date: Thu, 20 Aug 2026 16:11:07 +0800
Subject: [PATCH 2/2] audio: reset OpenJOC classification at segment boundaries

---
 filters/f_decoder_wrapper.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/filters/f_decoder_wrapper.c b/filters/f_decoder_wrapper.c
index 80e64b4bf4..9580c5def1 100644
--- a/filters/f_decoder_wrapper.c
+++ b/filters/f_decoder_wrapper.c
@@ -1343,6 +1343,13 @@ static void read_frame(struct priv *p)
 
         reset_decoder(p);
 
+#if HAVE_OPENJOC
+        // A segmented stream is a new classification scope. Never carry a
+        // prior file/track admission decision or retained probe packets over
+        // the boundary.
+        joc_probe_reset(p);
+#endif
+
         if (new_segment->segmented) {
             if (p->codec != new_segment->codec) {
                 p->codec = new_segment->codec;
