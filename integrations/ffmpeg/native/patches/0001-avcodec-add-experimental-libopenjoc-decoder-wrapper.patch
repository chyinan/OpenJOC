diff --git a/doc/decoders.texi b/doc/decoders.texi
index c8177c15e7..8fea5f5e48 100644
--- a/doc/decoders.texi
+++ b/doc/decoders.texi
@@ -347,6 +347,49 @@ Requires the presence of the libmpeghdec headers and library during
 configuration. You need to explicitly configure the build with
 @code{--enable-libmpeghdec --enable-nonfree}.
 
+@section libopenjoc
+
+OpenJOC E-AC-3 JOC decoder wrapper.
+
+This experimental decoder requires OpenJOC C ABI 1.2 or newer and a build
+configured with @code{--enable-version3 --enable-libopenjoc}. It is selected
+explicitly by the decoder name @code{libopenjoc}; the ordinary @code{eac3}
+decoder remains the generic/default decoder for the E-AC-3 codec ID.
+
+Output is packed float32 at 48 kHz. The decoder reports OpenJOC's deterministic
+rendering delay through @code{AVCodecContext.delay} and preserves logical frame
+timestamps in a 1/48000 time base without pre-subtracting that delay.
+
+@subsection Options
+
+@table @option
+
+@item render_mode
+Choose @code{speaker} (default), @code{stereo}, or @code{binaural}.
+
+@item speaker_layout
+Set the physical render target. Common values include @code{2.0}, @code{5.1},
+@code{7.1.4}, @code{9.1.6}, and @code{22.2}. A two-channel physical target does
+not imply headphone rendering.
+
+@item virtual_layout
+Set the virtual speaker target for binaural rendering. The default is
+@code{7.1.4}.
+
+@item drc
+Choose @code{disabled}, @code{line} (default), @code{rf}, or @code{custom}.
+The @option{drc_boost} and @option{drc_cut} percentage options apply to custom
+DRC.
+
+@item dialnorm
+Choose @code{default} (recommended), @code{digital}, or @code{analog}.
+
+@item sofa
+Load a custom SOFA file for binaural rendering. If omitted, OpenJOC uses its
+built-in SADIE II D1 resource.
+
+@end table
+
 @section libopencore-amrnb
 
 libopencore-amrnb decoder wrapper.
